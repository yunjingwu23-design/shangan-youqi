{
  "name": "shangan-youqi",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/unit.test.ts",
    "test:integration": "node --import tsx --test --test-concurrency=1 tests/integration.test.ts",
    "test:e2e": "playwright test",
    "worker:interviews": "node --import tsx scripts/interview-worker.ts",
    "test:interviews": "node --import tsx --test --test-concurrency=1 tests/interviews.test.ts",
    "db:start": "node scripts/local.mjs start",
    "db:stop": "node scripts/local.mjs stop",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "lucide-react": "1.65.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.6.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": "24.x"
  }
}
