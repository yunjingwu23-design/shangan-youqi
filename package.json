    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/unit.test.ts",
    "test:integration": "node --import tsx --test --test-concurrency=1 tests/integration.test.ts",
    "test:e2e": "playwright test",
    "worker:interviews": "node --import tsx scripts/interview-worker.ts",
    "admin:bootstrap": "node --import tsx scripts/admin-bootstrap.ts",
    "admin:cleanup-jd": "node --import tsx scripts/admin-cleanup-jd.ts",
    "admin:installer:build": "node scripts/build-admin-installer.mjs",
    "test:interviews": "node --import tsx --test --test-concurrency=1 tests/interviews.test.ts",
    "test:site": "node --import tsx --test --test-concurrency=1 tests/site.test.ts",
    "test:admin": "node --import tsx --test --test-concurrency=1 tests/admin.test.ts",
    "test:admin-email": "node --import tsx --test --test-concurrency=1 tests/admin-email.test.ts",
    "test:admin-install": "node --test tests/admin-installer.test.mjs",
    "test:analytics": "node --import tsx --test --test-concurrency=1 tests/analytics-unit.test.ts tests/analytics.test.ts",
    "analytics:cleanup": "node --import tsx scripts/analytics-cleanup.ts",
    "test:workspace-stages": "node --import tsx --test --test-concurrency=1 tests/workspace-stages.test.ts",
    "db:start": "node scripts/local.mjs start",
    "db:stop": "node scripts/local.mjs stop",
    "format": "prettier --write .",
