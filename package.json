    "docx-preview": "0.4.1",
    "fflate": "0.8.2",
    "harfbuzzjs": "1.6.4",
    "lucide-react": "1.65.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
