# Supabase project Settings > API. These are placeholders, never commit real keys.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_OR_PUBLISHABLE_KEY
# Server only; never prefix this key with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_OR_SECRET_KEY
# Public application origin. HTTPS is required outside localhost.
APP_URL=http://localhost:3000
# Generate with: openssl rand -hex 32; server-only HMAC for rate-limit identifiers.
AUTH_RATE_LIMIT_SECRET=REPLACE_WITH_RANDOM_64_HEX_CHARACTERS
# Enable only behind a proxy that overwrites X-Forwarded-For with a trusted client IP.
TRUST_PROXY=false

# Internal interview feature: apply both interview migrations and run the Worker first.
INTERVIEWS_ENABLED=false
# Worker only. Keep this key out of NEXT_PUBLIC_ variables and browser code.
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
OPENAI_REVIEW_MODEL=gpt-4.1-mini
# Budget estimates, not guaranteed current supplier prices.
OPENAI_TRANSCRIBE_USD_PER_MINUTE=0.006
OPENAI_REVIEW_INPUT_USD_PER_MILLION=0.4
OPENAI_REVIEW_OUTPUT_USD_PER_MILLION=1.6
